# Use `python tools/setup_demo.py` to generate a PRIVATE .env with random credentials.
POSTGRES_PASSWORD=
JWT_KEY=
SIMULATION_BRIDGE_KEY=
DEMO_ADMIN_PASSWORD=
DEMO_OPERATOR_PASSWORD=
DEMO_MAINTENANCE_PASSWORD=
WEB_PORT=8080
BIND_ADDRESS=127.0.0.1
SIMULATION_SECURE_COOKIES=false

# Optional physical robot connectivity, enabled by tools/mqtt_hotspot.py.
# Backend keeps mqtt:1883; robot notebooks keep this hotspot endpoint.
MQTT_HOTSPOT_ADDRESS=192.168.137.1
MQTT_HOTSPOT_PORT=1883
